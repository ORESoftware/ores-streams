{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORESoftware/ores-streams/raw/main/contracts/binary-stream-profile.schema.json",
  "title": "ORES binary stream profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "codec",
    "framing",
    "streaming",
    "max_encoded_bytes",
    "max_decoded_bytes",
    "fixed_codec"
  ],
  "properties": {
    "schema": {
      "const": "ores.streams.binary-profile/v1"
    },
    "codec": {
      "enum": [
        "json",
        "messagepack",
        "cbor",
        "protobuf",
        "raw"
      ]
    },
    "framing": {
      "enum": [
        "single",
        "length_delimited",
        "websocket_binary",
        "ndjson",
        "json_seq"
      ]
    },
    "streaming": {
      "type": "boolean"
    },
    "max_encoded_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "max_decoded_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "fixed_codec": {
      "type": "boolean"
    }
  }
}
